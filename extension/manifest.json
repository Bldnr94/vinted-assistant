{
  "manifest_version": 3,
  "name": "Annonces (Gemini helper)",
  "version": "1.1.0",
  "description": "Runs the app's Gemini model-photo jobs in your Gemini tab. It never runs on vinted.fr.",
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pages.dev/*"
      ],
      "js": [
        "bridge-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.pages.dev/*",
    "https://gemini.google.com/*"
  ]
}
